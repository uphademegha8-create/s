app.component.ts
// src/app/app.component.ts
import { Component, OnInit } from '@angular/core';
import { CommonModule } from '@angular/common';

@Component({
  selector: 'app-root',
  standalone: true,
  imports: [CommonModule],
  templateUrl: './app.component.html',
  styleUrls: ['./app.component.css']
})
export class AppComponent implements OnInit {
  students = [
    { name: 'pranjal', percentage: 91 },
    { name: 'payal', percentage: 85 },
    { name: 'veera', percentage: 72 },
    { name: 'mohini', percentage: 85 },
    { name: 'pooja', percentage: 88 }
  ];

  studentsWith85Percent: string[] = [];

  ngOnInit() {
    this.studentsWith85Percent = this.students
      .filter(student => student.percentage === 85)
      .map(student => student.name);
  }
}




