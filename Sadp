Q.1) Create a Node.js application that reads data from multiple files asynchronously using promises and async/await.

CREATE 3 TEXT FILES:file1.txt ,file2.txt,file3.txt

const fs = require('fs').promises; // Import the promise-based fs module

async function readMultipleFiles(filePaths) {
  try {
    const readPromises = filePaths.map(filePath => fs.readFile(filePath, 'utf8'));
    const fileContents = await Promise.all(readPromises);
    return fileContents;
  } catch (error) {
    console.error('Error reading files:', error);
    throw error; // Re-throw the error for external handling
  }
}

// Define the paths to the files you want to read
const filesToRead = ['file1.txt', 'file2.txt', 'file3.txt'];

// Call the async function and handle the results
readMultipleFiles(filesToRead)
  .then(contents => {
    console.log('Contents of all files:');
    contents.forEach((content, index) => {
      console.log(`--- Content of ${filesToRead[index]} ---`);
      console.log(content);
    });
  })
  .catch(error => {
    console.error('Failed to read one or more files:', error);
  });

