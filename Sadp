Q.1) Write an AngularJS script for addition of two numbers using ng-init, ng-model & ng-bind. And also demonstrate ng-show, ng-disabled, ng-click directives on button component.

<!DOCTYPE html>
<html ng-app>
<head>
  <meta charset="utf-8">
  <title>AngularJS Addition Example</title>
  <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
</head>
<body ng-init="num1=0; num2=0; result=0; showResult=false">
  <h2>Addition of Two Numbers</h2>
  <p>
    Number 1: <input type="number" ng-model="num1">
  </p>
  <p>
    Number 2: <input type="number" ng-model="num2">
  </p>
  <p>
    <button
      ng-click="result = num1 + num2; showResult=true"
      ng-disabled="num1 === null || num2 === null" <!--used to enable or disable the HTML elements.-->
      Add Numbers
    </button>
  </p>
  <div ng-show="showResult">
    <h3>Result:</h3>
    <p><strong ng-bind="result"></strong></p>
  </div>
</body>
</html>

