Q.2) Express.js application to include middleware for parsing request bodies (e.g.,
JSON, form data) and validating input data.

const express = require('express');
const app = express();
const port = 8084;
// Middleware for parsing JSON and form data
app.use(express.json());
app.use(express.urlencoded({ extended: true }));
// Custom middleware for validating input
function validateUserInput(req, res, next) {
  const { name, email } = req.body;
  if (!name || !email) {
    return res.status(400).json({ error: 'Name and email are required.' });
  }
  // Simple email pattern check
  const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  if (!emailPattern.test(email)) {
    return res.status(400).json({ error: 'Invalid email format.' });
  }
  next(); // All good, move on
}
// Route using middleware
app.post('/submit', validateUserInput, (req, res) => {
  const { name, email } = req.body;
  res.json({ message: 'Data received successfully!', data: { name, email } });
});

// Start server
app.listen(port, () => {
  console.log(`Server running at http://localhost:${port}`);
});


OR

const express = require('express');
const app = express();
app.use(express.json());

const validateUserInput = (req, res, next) => {
  const { name, email } = req.body;
  const validEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  if (!name || !email || !validEmail.test(email))
    return res.status(400).json({ error: 'Invalid input.' });
  next();
};

app.post('/submit', validateUserInput, (req, res) => {
  res.json({ message: 'Data received!', data: req.body });
});

app.listen(3000, () => console.log('Server running on http://localhost:3000'));




