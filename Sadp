Q.1) Find an emp with a Salary greater than 25000 in the array. (Using find by id method)

const employees = [
  { id: 1, name: "Alice", salary: 20000 },
  { id: 2, name: "Bob", salary: 30000 },
  { id: 3, name: "Charlie", salary: 25000 },
  { id: 4, name: "Diana", salary: 40000 }
];

// "findById" function
function findById(id) {
  return employees.find(emp => emp.id === id);
}

// Now check for salary > 25000
for (let i = 0; i < employees.length; i++) {
  const emp = findById(employees[i].id);
  if (emp.salary > 25000) {
    console.log("Found employee:", emp);
    break; // exit after finding the first match
  }
}

